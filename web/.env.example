# Copy to .env and fill in. Next.js loads web/.env for the API routes; it never reaches the browser.

# Gemini reads the free-text activity ("doubles badminton for 90 min"). Without a key, keyword rules stand in.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OneMap token for place search (it answers without one)
ONEMAP_TOKEN=

# Optional: path to the activity database; defaults to ../hazewise.db (the repo root)
HAZEWISE_DB=
