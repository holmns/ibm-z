# Copy to .env and fill in. Next.js loads web/.env for the API routes; it never reaches the browser.

# Embeds the free-text activity ("doubles badminton for 90 min") with openai/text-embedding-3-large, the model behind
# activities.embedding in hazewise.db. The activity lookup fails without it. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: the open-weight model that writes the summary under the risk title (default deepseek/deepseek-v4.1-flash)
SUMMARY_MODEL=

# Hourly PM2.5 from Google's Air Quality API (enable it on the key's Google Cloud project). It follows NEA's station
# readings in haze; without it PM2.5 falls back to Open-Meteo's CAMS forecast, which reads low in haze.
GOOGLE_MAPS_API_KEY=
